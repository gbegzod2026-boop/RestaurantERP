# Copy values into the process environment for local Step 1 acceptance.
# Do not commit a filled copy. Do not point these at restoran-30d51.

NESTA_REQUIRE_ISOLATED_AUTH=1
DATA_BACKEND=postgres

# Isolated Auth (Firebase Auth Emulator). Not production.
FIREBASE_PROJECT_ID=nesta-staging
FIREBASE_API_KEY=nesta-staging-emulator
FIREBASE_AUTH_DOMAIN=nesta-staging.firebaseapp.com
FIREBASE_APP_ID=1:0:web:nesta-staging
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_DATABASE_URL=

# Optional: a real non-production Google Firebase project instead of emulator.
# NESTA_ALLOW_REMOTE_STAGING=1
# FIREBASE_SERVICE_ACCOUNT_PATH=  (staging JSON only; never restoran-30d51)

# PostgreSQL remains the local loopback test database from backend/.env
# DATA_BACKEND=postgres is required. Do not set firebase.
