PORT=4000

# ──────────────────────────────────────────────────────────────────────────
# NODE_ENV — P2 fix (PRODUCTION-AUDIT.md #16). Currently only gates one
# thing in this codebase: security/headers.js's Content-Security-Policy sets
# upgradeInsecureRequests (tells browsers to auto-upgrade any accidental
# http:// subresource reference to https://) only when NODE_ENV==="production".
# Left unset, that protection is silently inactive regardless of how/where
# this is actually deployed. Set this to "production" in the real deployment
# environment once it's served over HTTPS — leave unset for local dev (an
# upgrade-insecure-requests CSP on a plain-http localhost breaks nothing
# security-critical, but there's no reason to send it for a dev server that
# isn't on HTTPS to begin with).
NODE_ENV=

# ──────────────────────────────────────────────────────────────────────────
# TRUST PROXY — Production Security Fix Pass (P1-1). Leave unset unless this
# app runs behind a reverse proxy/load balancer/CDN (nginx, Cloudflare, a
# platform's own edge proxy, etc.) that terminates TLS and forwards requests
# to this Node process. Every rate limiter (security/rateLimit.js) and the
# audit log's recorded IP key off req.ip, which this setting controls.
#   - Set this WRONG in either direction and it becomes a real vulnerability:
#     enabling it with NO real proxy in front makes req.ip read the
#     client-supplied X-Forwarded-For header directly (trivially spoofable,
#     defeats every IP-based rate limit); leaving it unset WITH a real proxy
#     in front makes req.ip always resolve to the proxy's own IP (collapses
#     every rate limiter into one shared bucket across all real users).
#   - Only the person who knows the actual deployment topology should set
#     this — it is intentionally never auto-detected or guessed by the app.
# Leave empty = Express's own default (trust nothing, use the raw socket
# address) — safe when this process is directly internet-facing.
#   TRUST_PROXY=1     — trust exactly one hop (a single nginx/Cloudflare proxy
#                        directly in front of this process — the common case)
#   TRUST_PROXY=true  — trust the nearest hop unconditionally
TRUST_PROXY=

# ──────────────────────────────────────────────────────────────────────────
# FIREBASE ADMIN SDK — Production Security Fix Pass (Critical), required for:
#   - Real Firebase Auth sessions at login (routes/auth.js), which is what
#     lets database.rules.json check auth.uid/auth.token.restId/role instead
#     of being open to every client.
#   - Verifying Authorization: Bearer <id-token> on backend API requests
#     instead of trusting the x-user-id header (rbac.js).
# Get this from: Firebase Console → Project Settings → Service Accounts →
# "Generate new private key". Save the downloaded JSON as
# backend/serviceAccountKey.json (already gitignored — never commit it).
# Alternatively set GOOGLE_APPLICATION_CREDENTIALS to its path (standard
# Google Cloud env var), which takes precedence if both are present.
# Leave both unset and the app runs exactly as it did before this fix pass
# (no Firebase Auth session at login, x-user-id trusted as before) — see
# backend/firebaseAdmin.js for the exact fallback behavior.
FIREBASE_SERVICE_ACCOUNT_PATH=
# GOOGLE_APPLICATION_CREDENTIALS=

# ──────────────────────────────────────────────────────────────────────────
# SECURITY — Production Security Audit (2026) additions. All optional /
# backward compatible: leaving these empty keeps prior behavior unchanged.
# ──────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins for CORS, e.g.
# "https://admin.nesta.uz,https://app.nesta.uz". Leave empty to keep the
# existing behavior (reflect any request origin) — set this once you know
# your production domain(s) to stop arbitrary third-party sites from calling
# this API with credentials from a browser.
ALLOWED_ORIGINS=

# 32-byte (64 hex chars) key used to encrypt 2FA TOTP secrets/backup codes
# at rest in Firebase. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required only if any employee enables 2FA (Settings). Rotating this key
# invalidates existing 2FA setups (employees would need to re-enroll).
ENCRYPTION_KEY=

# Firebase config — admin.js dagi bilan bir xil bo'lishi SHART
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Default restoran ID (URL dan ham o'tkazish mumkin)
DEFAULT_REST_ID=

# ──────────────────────────────────────────────────────────────────────────
# POSTGRESQL — Phase 2 (Firebase → PostgreSQL migration), Wave 0. Nothing in
# the running app reads from Postgres yet (see db/postgres.js's header) —
# these vars only matter once you actually run db/migrate.js or
# db/tests/rls.test.mjs against a real instance. Leave all empty and the app
# runs exactly as before, unaffected (db/postgres.js degrades the same way
# firebaseAdmin.js does when unconfigured).
#
# Either set POSTGRES_URL (a single connection string) OR the five
# POSTGRES_HOST/PORT/DB/USER/PASSWORD vars — POSTGRES_URL takes precedence
# if both are present. The connecting user should be a role with schema
# privileges (CREATE/ALTER/DROP) — this is the "migration role" the task
# spec asked for; it is intentionally NOT the same role the Express backend
# would use at runtime (see nesta_app below).
# ──────────────────────────────────────────────────────────────────────────
# POSTGRES_URL=postgres://user:password@host:5432/nesta
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Set to "true" when the server requires TLS (managed hosts do). Railway
# public proxy hosts (*.proxy.rlwy.net) always encrypt via db/pgSsl.js.
# Stock Railway Postgres uses CN=localhost and an unpublished per-instance
# CA, so hostname-verified TLS is not available there. Optional pin:
# POSTGRES_SSL_CA_FILE=/path/to/railway-root.crt
# Never set NODE_TLS_REJECT_UNAUTHORIZED=0.
POSTGRES_SSL=
# POSTGRES_SSL_CA_FILE=
POSTGRES_POOL_MAX=10
# Step 2D.4 restore target (local loopback only). Never set this to
# DATABASE_PUBLIC_URL. Restore database name is always nesta_step2d4_restore.
# Admin catalog may be postgres; dump source remains DATABASE_PUBLIC_URL.
# STEP2D4_RESTORE_DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
# PostgreSQL 18 client tools (required to dump Railway 18.x). Prefer these over PATH.
# PG_DUMP_BIN=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
# PG_RESTORE_BIN=C:\Program Files\PostgreSQL\18\bin\pg_restore.exe
# Production pool: do not raise blindly. Formula:
#   floor((max_connections - 5 superuser/monitor - 2 migrate) / backend_instance_count)
# Local default 10. Cutover: one migrate process + app instances must leave
# headroom. Set explicitly per host after SHOW max_connections.

# NESTA_MAINTENANCE_MODE — cutover write freeze. Set to 1 only during the
# production migration window. Server rejects tenant mutations and payment
# webhooks with HTTP 503 MAINTENANCE (Retry-After: 120). Login and health
# stay up. Never enable from the client; env only.
# NESTA_MAINTENANCE_MODE=1

# Production Firebase→PostgreSQL --apply is refused unless ALL of these match
# exactly. Values yes/true/1 are not accepted. Unset NESTA_MIGRATE_TARGET
# keeps the loopback nesta_migration_dryrun guard.
# NESTA_MIGRATE_TARGET=production
# NESTA_PRODUCTION_MIGRATE_CONFIRM=I_CONFIRM_PRODUCTION_FIREBASE_TO_POSTGRES_CUTOVER
# NESTA_PRODUCTION_MIGRATE_TAG=nesta-step2-cutover-ready
# NESTA_PRODUCTION_ALLOW_RESUME=nesta-step2-cutover-ready
# NESTA_BACKEND_INSTANCES=1

# Payment cutover. Click/Payme/Uzum stay BLOCKED until operator pause is
# confirmed. HTTP 503 is not a guaranteed provider retry. DURABLE_QUEUE is
# not implemented.
# NESTA_PAYMENT_CUTOVER_MODE=BLOCKED
# NESTA_PAYMENT_PAUSE_CONFIRM=CLICK_PAYME_UZUM_PAUSED_IN_PROVIDER_CABINET

# Optional operator paths for backup verification (never commit the files):
# NESTA_FIREBASE_BACKUP_PATH=
# NESTA_PG_BACKUP_PATH=
# NESTA_ENV_BACKUP_PATH=

# Password for the nesta_app role (0001_wave0_core.up.sql creates the role
# itself with no password — this is the ONLY place that password is set,
# via `npm run db:set-app-password`, never embedded in any .sql file).
# Required only when you actually rotate/set nesta_app's password; not read
# anywhere else.
# DATA_BACKEND — Phase 2 Firebase → PostgreSQL API cutover flag.
#   firebase   (default) — panels keep reading/writing Firebase RTDB
#   postgres            — mapped paths go through /api/pg + Socket.IO
# Firebase code is NOT deleted in either mode. Switch back by setting firebase.
DATA_BACKEND=firebase


# ──────────────────────────────────────────────────────────────────────────
# CLICK (https://docs.click.uz)
# Click Merchant kabinetida (my.click.uz) ro'yxatdan o'tib oling.
# Sandbox/test uchun ham xuddi shu kabinet ishlatiladi — "test" service
# alohida belgilanadi.
# ──────────────────────────────────────────────────────────────────────────
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
# Required — Production Security Fix Pass: the webhook now REJECTS every
# request while this is empty (it used to silently accept unsigned webhooks
# instead). Set this before enabling Click in production.
CLICK_SECRET_KEY=

# ──────────────────────────────────────────────────────────────────────────
# PAYME (https://developer.help.paycom.uz)
# Test kalitlari Payme Business kabinetida "Sandbox" bo'limida beriladi.
# ──────────────────────────────────────────────────────────────────────────
PAYME_MERCHANT_ID=
# Required — Production Security Fix Pass: the webhook now REJECTS every
# request while this is empty (it used to accept an empty-password Basic
# Auth request as valid). Set this before enabling Payme in production.
PAYME_KEY=

# ──────────────────────────────────────────────────────────────────────────
# UZUM BANK (https://developer.uzumbank.uz)
# Sandbox bazasi va kalitlari merchants.uzumbank.uz kabinetida beriladi.
# ──────────────────────────────────────────────────────────────────────────
UZUM_API_BASE=https://api.test.uzumbank.uz
UZUM_SERVICE_ID=
UZUM_API_KEY=
# Required — Production Security Fix Pass: the webhook now REJECTS every
# request while this is empty (it used to disable signature verification
# entirely). Set this before enabling Uzum Bank in production.
UZUM_WEBHOOK_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# Umumiy
# ──────────────────────────────────────────────────────────────────────────
# To'lovdan keyin foydalanuvchi qaytariladigan sahifa (masalan client ilovasi)
PAYMENT_RETURN_URL=https://yourdomain.uz/payment/success

# ──────────────────────────────────────────────────────────────────────────
# DELIVERY MANAGEMENT — Telegram bot notifications (New Delivery, Courier
# Assigned, Picked Up, Delivered, Cancelled).
#
# P1-7 fix (PRODUCTION-AUDIT.md): TELEGRAM_BOT_TOKEN below is NOT read by any
# backend code (confirmed by grepping the whole repo) — it's kept only so an
# operator scanning this file isn't surprised the feature exists. The bot
# token is actually per-restaurant, entered via the Admin UI and stored in
# Firebase at restaurants/{id}/settings (see backend/notifications/
# TelegramBotService.js, which reads settings.telegram.botToken/chatId, not
# process.env). Leaving this var unset here has no effect either way — do
# not rely on it.
# ──────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# Yandex Go delivery provider — per-restaurant apiKey/clientId/environment
# are stored in restaurants/{id}/settings/deliverySettings.yandexGo (set via
# Admin → Settings → Delivery). No global key needed here; this backend
# integration is currently mocked (see backend/delivery/providers/YandexGoProvider.js).

# ──────────────────────────────────────────────────────────────────────────
# AI SMART IMPORT — Google Gemini (https://ai.google.dev)
# Get a key from Google AI Studio. Used ONLY by backend/aiImport/geminiImportService.js
# for AI Mode (module auto-detection + extraction) and the legacy quick-capture
# endpoint — Manual Import never calls this and incurs zero AI cost.
# Leave GEMINI_API_KEY empty to disable AI Import (Manual Import keeps working).
# ──────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
